// Prisma Schema для AI Agent Бухгалтерии
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?

  // OAuth providers
  googleId     String?  @unique
  githubId     String?  @unique

  // User preferences
  locale       String   @default("en") // User's preferred language (en, pl)
  isFirstLogin Boolean  @default(true) // Flag for showing welcome modal on first login

  // wFirma integration config
  wfirmaConfig Json?    @db.JsonB

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  // Relations
  conversations   AIConversation[]
  wfirmaCache     WFirmaCache[]
  apiCredentials  UserApiCredentials?

  @@index([email])
  @@index([googleId])
  @@index([githubId])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// USER API CREDENTIALS
// ============================================

model UserApiCredentials {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid

  // wFirma credentials (encrypted JSON: {ciphertext, iv, tag})
  wfirmaEnabled         Boolean  @default(false)
  wfirmaAccessKey       String?  @db.Text
  wfirmaSecretKey       String?  @db.Text
  wfirmaCompanyId       String?  @db.Text

  // LLM Provider credentials
  llmProvider           String?  // 'openai' | 'anthropic' | null (use app default)
  llmApiKey             String?  @db.Text

  // Metadata
  wfirmaLastValidated   DateTime?
  llmLastValidated      DateTime?

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_api_credentials")
}

// ============================================
// AI CONVERSATIONS
// ============================================

model AIConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid

  // Conversation details
  title       String
  topic       String?

  // Messages history
  messages    Json     @db.JsonB

  // LangGraph state
  graphState  Json?    @db.JsonB

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_conversations")
}

// ============================================
// WFIRMA CACHE
// ============================================

model WFirmaCache {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid

  // Type of cached data
  dataType      String   // company, contractor, invoice, financial

  // ID of object in wFirma
  wfirmaId      String

  // Cached data
  data          Json     @db.JsonB

  // Cache metadata
  cachedAt      DateTime @default(now())
  expiresAt     DateTime
  isValid       Boolean  @default(true)

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dataType, wfirmaId])
  @@index([userId, dataType])
  @@index([expiresAt])
  @@index([isValid])
  @@map("wfirma_cache")
}
