// Prisma Schema для AI Agent Бухгалтерии
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  user
  admin
}

enum SubscriptionPlan {
  free
  pro
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

enum PaymentType {
  board_resolution
  employment
  mandate_contract
  work_contract
  dividend
}

enum ContractStatus {
  draft
  active
  terminated
  expired
}

enum AbsenceType {
  vacation
  sick_leave
  maternity
  unpaid
  other
}

enum KSeFSessionStatus {
  active
  expired
  terminated
  failed
}

enum KSeFInvoiceStatusEnum {
  pending
  sending
  sent
  accepted
  rejected
  completed
  failed
}

enum KSeFAdapterType {
  wfirma
  direct
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?

  // OAuth providers
  googleId     String?  @unique
  githubId     String?  @unique

  // User preferences
  locale       String   @default("en") // User's preferred language (en, pl)
  role         UserRole @default(user) // User role for access control
  isFirstLogin Boolean  @default(true) // Flag for showing welcome modal on first login

  // Subscription
  subscriptionPlan      SubscriptionPlan   @default(free)
  subscriptionStatus    SubscriptionStatus @default(active)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  subscriptionEndDate   DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)

  // AI usage limits (for Pro with app keys)
  aiMessagesUsed        Int                @default(0)
  aiMessagesLimit       Int                @default(500)
  aiMessagesResetAt     DateTime?

  // wFirma usage limits (for Free plan)
  wfirmaRequestsUsed    Int                @default(0)
  wfirmaRequestsLimit   Int                @default(30)
  wfirmaRequestsResetAt DateTime?

  // LLM key preference (for Pro users)
  useOwnLLMKey          Boolean            @default(false)

  // TTS usage tracking (stored in DB instead of LangSmith)
  ttsCharactersUsed     Int                @default(0)
  ttsCostUsd            Float              @default(0)

  // wFirma integration config
  wfirmaConfig Json?    @db.JsonB

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  // Relations
  conversations   AIConversation[]
  wfirmaCache     WFirmaCache[]
  apiCredentials  UserApiCredentials?
  employees       Employee[]
  ksefConfig        KSeFConfig?
  ksefCertificates  KSeFCertificate[]
  ksefSessions      KSeFSession[]
  ksefInvoices      KSeFInvoiceStatus[]
  ksefContractors   KSeFContractor[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([googleId])
  @@index([githubId])
  @@index([createdAt])
  @@index([stripeCustomerId])
  @@index([subscriptionPlan])
  @@map("users")
}

// ============================================
// USER API CREDENTIALS
// ============================================

model UserApiCredentials {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid

  // wFirma credentials (encrypted JSON: {ciphertext, iv, tag})
  wfirmaEnabled         Boolean  @default(false)
  wfirmaAccessKey       String?  @db.Text
  wfirmaSecretKey       String?  @db.Text
  wfirmaCompanyId       String?  @db.Text

  // LLM Provider credentials
  llmProvider           String?  // 'openai' | 'google' | null (use app default)
  llmApiKey             String?  @db.Text
  llmModel              String?  // e.g., 'gpt-4o', 'gemini-2.5-flash'

  // Metadata
  wfirmaLastValidated   DateTime?
  llmLastValidated      DateTime?

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_api_credentials")
}

// ============================================
// AI CONVERSATIONS
// ============================================

model AIConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid

  // Conversation details
  title       String
  topic       String?

  // Messages history
  messages    Json     @db.JsonB

  // LangGraph state
  graphState  Json?    @db.JsonB

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_conversations")
}

// ============================================
// WFIRMA CACHE
// ============================================

model WFirmaCache {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid

  // Type of cached data
  dataType      String   // company, contractor, invoice, financial

  // ID of object in wFirma
  wfirmaId      String

  // Cached data
  data          Json     @db.JsonB

  // Cache metadata
  cachedAt      DateTime @default(now())
  expiresAt     DateTime
  isValid       Boolean  @default(true)

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dataType, wfirmaId])
  @@index([userId, dataType])
  @@index([expiresAt])
  @@index([isValid])
  @@map("wfirma_cache")
}

// ============================================
// HR & PAYROLL
// ============================================

model Employee {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  firstName     String
  lastName      String
  pesel         String?
  nip           String?
  dateOfBirth   DateTime?
  email         String?
  phone         String?
  street        String?
  city          String?
  zip           String?
  country       String    @default("PL")
  bankAccount   String?
  taxOffice     String?
  notes         String?
  isActive      Boolean   @default(true)
  hiredAt       DateTime?
  firedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts     EmploymentContract[]
  payrolls      PayrollRecord[]
  absences      Absence[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("employees")
}

model EmploymentContract {
  id                String          @id @default(uuid()) @db.Uuid
  employeeId        String          @db.Uuid
  type              PaymentType
  status            ContractStatus  @default(draft)
  position          String?
  department        String?
  startDate         DateTime
  endDate           DateTime?
  baseSalaryGross   Decimal         @db.Decimal(12, 2)
  workHoursPerWeek  Decimal?        @db.Decimal(4, 1)
  costDeductionRate Decimal?        @db.Decimal(5, 2)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrolls          PayrollRecord[]

  @@index([employeeId])
  @@index([employeeId, status])
  @@map("employment_contracts")
}

model PayrollRecord {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @db.Uuid
  contractId      String    @db.Uuid
  period          String

  // Gross
  grossAmount     Decimal   @db.Decimal(12, 2)
  bonuses         Decimal   @default(0) @db.Decimal(12, 2)
  deductions      Decimal   @default(0) @db.Decimal(12, 2)

  // ZUS employee side
  zusEmerytalne   Decimal   @default(0) @db.Decimal(12, 2)
  zusRentowe      Decimal   @default(0) @db.Decimal(12, 2)
  zusChorobowe    Decimal   @default(0) @db.Decimal(12, 2)
  zusZdrowotne    Decimal   @default(0) @db.Decimal(12, 2)

  // ZUS employer side
  zusEmerytalneEmployer  Decimal @default(0) @db.Decimal(12, 2)
  zusRentoweEmployer     Decimal @default(0) @db.Decimal(12, 2)
  zusWypadkowe           Decimal @default(0) @db.Decimal(12, 2)
  zusFP                  Decimal @default(0) @db.Decimal(12, 2)
  zusFGSP                Decimal @default(0) @db.Decimal(12, 2)

  // Tax
  taxBase         Decimal   @default(0) @db.Decimal(12, 2)
  incomeTax       Decimal   @default(0) @db.Decimal(12, 2)

  // Net
  netAmount       Decimal   @db.Decimal(12, 2)

  // Total employer cost
  totalEmployerCost Decimal @db.Decimal(12, 2)

  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contract        EmploymentContract @relation(fields: [contractId], references: [id])

  @@unique([employeeId, contractId, period])
  @@index([employeeId])
  @@index([period])
  @@map("payroll_records")
}

model Absence {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @db.Uuid
  type          AbsenceType
  startDate     DateTime
  endDate       DateTime
  businessDays  Int
  notes         String?
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, startDate, endDate])
  @@map("absences")
}

// ============================================
// KSEF (Polish National e-Invoice System)
// ============================================

model KSeFConfig {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @unique @db.Uuid
  preferredAdapter  KSeFAdapterType @default(wfirma)
  autoSendEnabled   Boolean         @default(false)
  autoSendOnCreate  Boolean         @default(false)
  environment       String          @default("test")
  defaultCertId     String?         @db.Uuid
  notifyOnAccepted  Boolean         @default(true)
  notifyOnRejected  Boolean         @default(true)
  notificationEmail String?
  ksefToken         String?         @db.Text // Autoryzacyjny token from KSeF portal (encrypted in future)
  ksefNip           String?                  // NIP/identifier for KSeF session
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ksef_config")
}

model KSeFCertificate {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  certificateData String   @db.Text
  password        String?  @db.Text
  subject         String
  issuer          String
  serialNumber    String
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        KSeFSession[]

  @@index([userId])
  @@index([validUntil])
  @@map("ksef_certificates")
}

model KSeFSession {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  sessionToken    String            @db.Text
  certificateId   String?           @db.Uuid
  status          KSeFSessionStatus @default(active)
  initiatedAt     DateTime          @default(now())
  expiresAt       DateTime
  terminatedAt    DateTime?
  environment     String            @default("test")
  lastUsedAt      DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate     KSeFCertificate?  @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  invoices        KSeFInvoiceStatus[]

  @@index([userId])
  @@index([expiresAt])
  @@map("ksef_sessions")
}

model KSeFInvoiceStatus {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  wfirmaInvoiceId     String?
  ksefReferenceNumber String?               @unique
  ksefInvoiceNumber   String?
  ksefSessionRef      String?               // KSeF session reference (e.g. 20260218-SO-...) for status polling
  contractorName      String?               // Contractor/counterparty name (for display in lists)
  contractorNip       String?               // Contractor NIP (for incoming invoice matching)
  totalGross          Decimal?              @db.Decimal(12, 2) // Total gross amount
  currency            String?               @default("PLN")    // Currency code
  invoiceDate         DateTime?             // Invoice issue date from the document
  status              KSeFInvoiceStatusEnum @default(pending)
  adapter             KSeFAdapterType       @default(wfirma)
  direction           String                @default("sent")
  sessionId           String?               @db.Uuid
  upoDownloaded       Boolean               @default(false)
  upoContent          Bytes?
  upoDownloadedAt     DateTime?
  sentAt              DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  invoicePayload      Json?                 // Full FA(3) invoice data (stored for direct adapter invoices to enable copy)
  errorCode           String?
  errorMessage        String?               @db.Text
  retryCount          Int                   @default(0)
  lastRetryAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  session             KSeFSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([wfirmaInvoiceId])
  @@index([status])
  @@index([sentAt])
  @@index([userId, status])
  @@index([userId, direction])
  @@map("ksef_invoice_status")
}

model KSeFContractor {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  nip       String?
  email     String?
  street    String?
  city      String?
  zip       String?
  country   String   @default("PL")
  source    String   @default("local") // 'local' | 'wfirma' | 'company'
  wfirmaId  String?  // null for local-only entries

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wfirmaId])
  @@index([userId])
  @@index([userId, source])
  @@map("ksef_contractors")
}

// ============================================
// HELP TOPICS (Multilingual Documentation)
// ============================================

model HelpTopic {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g., "getting-started-welcome"
  category    String   // e.g., "gettingStarted", "aiChat", "invoices"

  // Multilingual content
  titlePl     String
  titleEn     String
  titleRu     String
  contentPl   String   @db.Text
  contentEn   String   @db.Text
  contentRu   String   @db.Text

  // Search optimization
  searchKeywordsPl String[] // For better search results
  searchKeywordsEn String[]
  searchKeywordsRu String[]

  // Organization
  order       Int      @default(0) // Display order within category
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([slug])
  @@map("help_topics")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  changes   Json?    @db.JsonB
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}
