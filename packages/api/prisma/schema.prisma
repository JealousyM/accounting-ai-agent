// Prisma Schema для AI Agent Бухгалтерии
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  
  // OAuth providers
  googleId     String?  @unique
  githubId     String?  @unique
  
  // User preferences
  locale       String   @default("en") // User's preferred language (en, pl)
  
  // wFirma integration config
  wfirmaConfig Json?    @db.JsonB
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  
  // Relations
  invoices        WFirmaInvoice[]
  customers       WFirmaCustomer[]
  conversations   AIConversation[]
  recommendations AIRecommendation[]
  wfirmaCache     WFirmaCache[]
  uchwaly         Uchwala[]
  auditLogs       AuditLog[]
  conversationSessions ConversationSession[]
  
  @@index([email])
  @@index([googleId])
  @@index([githubId])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// WFIRMA INVOICES
// ============================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  OVERDUE
  CANCELLED
  
  @@map("invoice_status")
}

model WFirmaInvoice {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  
  // wFirma identifiers
  invoiceNumber    String
  invoiceIdWFirma  String        @unique
  
  // Customer information
  customerId       String?       @db.Uuid
  customerName     String
  customerEmail    String?
  customerPhone    String?
  customerNip      String?
  customerAddress  Json?         @db.JsonB
  
  // Financial data
  amount           Decimal       @db.Decimal(12, 2)
  vat              Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  currency         String        @default("PLN")
  
  // Dates
  issueDate        DateTime
  dueDate          DateTime
  paidDate         DateTime?
  
  // Status
  status           InvoiceStatus @default(DRAFT)
  
  // Additional data
  items            Json?         @db.JsonB
  notes            String?       @db.Text
  metadata         Json?         @db.JsonB
  
  // Timestamps
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  
  // Relations
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer         WFirmaCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([userId, status])
  @@index([userId, issueDate])
  @@map("wfirma_invoices")
}

// ============================================
// WFIRMA CUSTOMERS
// ============================================

model WFirmaCustomer {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  
  // wFirma identifier
  customerIdWFirma  String   @unique
  
  // Customer details
  name              String
  email             String?
  phone             String?
  nip               String?  @unique
  
  // Address
  address           Json?    @db.JsonB
  
  // Statistics
  totalRevenue      Decimal  @default(0) @db.Decimal(12, 2)
  totalInvoices     Int      @default(0)
  
  // Additional data
  metadata          Json?    @db.JsonB
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  
  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices          WFirmaInvoice[]
  
  @@index([userId])
  @@index([nip])
  @@index([email])
  @@index([userId, totalRevenue])
  @@map("wfirma_customers")
}

// ============================================
// AI CONVERSATIONS
// ============================================

model AIConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  
  // Conversation details
  title       String
  topic       String?
  
  // Messages history
  messages    Json     @db.JsonB
  
  // LangGraph state
  graphState  Json?    @db.JsonB
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  // Relations
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations AIRecommendation[]
  
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_conversations")
}

// ============================================
// AI RECOMMENDATIONS
// ============================================

enum RecommendationStatus {
  PENDING
  REVIEWED
  IMPLEMENTED
  REJECTED
  
  @@map("recommendation_status")
}

enum RecommendationCategory {
  TAX_OPTIMIZATION
  CASH_FLOW
  EXPENSE_REDUCTION
  REVENUE_GROWTH
  COMPLIANCE
  AUTOMATION
  REPORTING
  OTHER
  
  @@map("recommendation_category")
}

model AIRecommendation {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @db.Uuid
  conversationId  String?                @db.Uuid
  
  // Recommendation details
  category        RecommendationCategory
  title           String
  description     String                 @db.Text
  
  // Scoring
  impactScore     Decimal                @db.Decimal(5, 2) // 0-100
  confidenceScore Decimal                @db.Decimal(5, 2) // 0-100
  
  // Status
  status          RecommendationStatus   @default(PENDING)
  
  // Additional data
  metadata        Json?                  @db.JsonB
  
  // Timestamps
  createdAt       DateTime               @default(now())
  reviewedAt      DateTime?
  implementedAt   DateTime?
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  
  // Relations
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([category])
  @@index([impactScore])
  @@index([userId, status])
  @@index([userId, category])
  @@index([createdAt])
  @@map("ai_recommendations")
}

// ============================================
// WFIRMA CACHE
// ============================================

model WFirmaCache {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  
  // Type of cached data
  dataType      String   // company, contractor, invoice, financial
  
  // ID of object in wFirma
  wfirmaId      String
  
  // Cached data
  data          Json     @db.JsonB
  
  // Cache metadata
  cachedAt      DateTime @default(now())
  expiresAt     DateTime
  isValid       Boolean  @default(true)
  
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, dataType, wfirmaId])
  @@index([userId, dataType])
  @@index([expiresAt])
  @@index([isValid])
  @@map("wfirma_cache")
}

// ============================================
// CONVERSATION SESSIONS (for AI Agent)
// ============================================

enum ConversationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  
  @@map("conversation_status")
}

model ConversationSession {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  
  // Conversation details
  type            String              // Type of uchwała being created
  status          ConversationStatus  @default(ACTIVE)
  
  // Collected data during conversation
  collectedData   Json                @db.JsonB
  
  // Current step in the conversation flow
  currentStep     String
  
  // Messages history
  messages        Json                @db.JsonB
  
  // wFirma data cached for this conversation
  companyData     Json?               @db.JsonB
  
  // Timestamps
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?
  
  // Relations
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@map("conversation_sessions")
}

// ============================================
// CORPORATE RESOLUTIONS (UCHWAŁY)
// ============================================

enum UchwalaType {
  ZARZADU
  DYWIDENDA
  RADA_NADZORCZA
  TANTIEMA
  
  @@map("uchwala_type")
}

enum UchwalaStatus {
  DRAFT
  PENDING_SIGNATURE
  APPROVED
  REJECTED
  ARCHIVED
  
  @@map("uchwala_status")
}

model Uchwala {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  
  // Основные данные
  type                UchwalaType
  number              String        @unique
  title               String
  status              UchwalaStatus @default(DRAFT)
  
  // Данные резолюции (JSON) - включает данные из wFirma
  data                Json          @db.JsonB
  
  // Ссылка на компанию в wFirma
  wfirmaCompanyId     String?
  
  // Расчеты налогов
  taxCalculation      Json?         @db.JsonB
  
  // Документы
  documentUrl         String?
  signatureRequestId  String?
  
  // Версионирование
  version             Int           @default(1)
  
  // Timestamps
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  approvedAt          DateTime?
  deletedAt           DateTime?
  
  // Relations
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments            Payment[]
  uchwalaInvoices     UchwalaInvoice[]
  auditLogs           AuditLog[]
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([userId, type])
  @@index([userId, status])
  @@index([wfirmaCompanyId])
  @@map("uchwaly")
}

// ============================================
// PAYMENTS
// ============================================

enum PaymentStatus {
  PENDING
  SCHEDULED
  SENT
  CONFIRMED
  FAILED
  
  @@map("payment_status")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  uchwalaId         String        @db.Uuid
  
  // Получатель (может быть из wFirma contractors)
  recipientName     String
  recipientAccount  String
  recipientNip      String?
  wfirmaContractorId String?      // Ссылка на контрагента в wFirma
  
  // Суммы
  amountGross       Decimal       @db.Decimal(12, 2)
  amountNet         Decimal       @db.Decimal(12, 2)
  taxAmount         Decimal       @db.Decimal(12, 2)
  zusAmount         Decimal?      @db.Decimal(12, 2)
  
  // Статус и даты
  status            PaymentStatus @default(PENDING)
  scheduledDate     DateTime
  processedDate     DateTime?
  
  // Банковские данные
  bankReference     String?
  transactionId     String?
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  uchwala           Uchwala       @relation(fields: [uchwalaId], references: [id], onDelete: Cascade)
  
  @@index([uchwalaId])
  @@index([status])
  @@index([scheduledDate])
  @@index([wfirmaContractorId])
  @@map("payments")
}

// ============================================
// UCHWALA INVOICES
// ============================================

model UchwalaInvoice {
  id                String        @id @default(uuid()) @db.Uuid
  uchwalaId         String        @db.Uuid
  
  // Ссылка на инвойс в wFirma (основной источник данных)
  wfirmaInvoiceId   String        @unique
  
  // Кэшированные данные для быстрого доступа
  invoiceNumber     String
  issueDate         DateTime
  dueDate           DateTime
  total             Decimal       @db.Decimal(12, 2)
  currency          String        @default("PLN")
  status            String        // Синхронизируется из wFirma
  
  // Синхронизация
  lastSyncedAt      DateTime?
  syncStatus        String        @default("pending") // pending, synced, error
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  uchwala           Uchwala       @relation(fields: [uchwalaId], references: [id], onDelete: Cascade)
  
  @@index([uchwalaId])
  @@index([wfirmaInvoiceId])
  @@index([status])
  @@map("uchwala_invoices")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  uchwalaId   String?  @db.Uuid
  userId      String   @db.Uuid
  
  // Действие
  action      String
  entityType  String
  entityId    String
  
  // Данные
  oldData     Json?    @db.JsonB
  newData     Json?    @db.JsonB
  
  // Метаданные
  ipAddress   String?
  userAgent   String?
  
  // Timestamp
  createdAt   DateTime @default(now())
  
  // Relations
  uchwala     Uchwala? @relation(fields: [uchwalaId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([uchwalaId])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================
// UCHWALA TEMPLATES
// ============================================

model UchwalaTemplate {
  id              String      @id @default(uuid()) @db.Uuid
  
  // Тип и язык
  type            UchwalaType
  locale          String      @default("pl")
  
  // Данные шаблона
  name            String
  description     String?
  content         String      @db.Text
  requiredFields  String[]
  
  // Версионирование
  version         String
  isActive        Boolean     @default(true)
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@unique([type, locale, version])
  @@index([type, locale, isActive])
  @@map("uchwala_templates")
}
