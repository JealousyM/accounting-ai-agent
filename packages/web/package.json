    "clsx": "^2.0.0",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "next-intl": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.49.2",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
