{
  "name": "@accounting-ai-agent/web",
  "version": "1.0.0",
  "description": "Frontend приложение для AI Agent бухгалтерии",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint . --ext .ts,.tsx --fix --max-warnings 20",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 20",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
